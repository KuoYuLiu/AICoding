# Code runner: judge0 (default) or docker (local development only, needs Docker running)
CODE_RUNNER=
# Test-only: lets `next start` (production mode) use the docker runner, as CI end-to-end tests do. Never set in a real deployment.
CODE_RUNNER_ALLOW_DOCKER_IN_PRODUCTION=

# Judge0 (stage 0 uses a hosted API). RapidAPI: JUDGE0_URL=https://judge0-ce.p.rapidapi.com and the RapidAPI key; self-hosted: its AUTHN_TOKEN
JUDGE0_URL=
JUDGE0_API_KEY=

# Claude API
ANTHROPIC_API_KEY=
# Model id for the AI assistant (default claude-opus-5-5)
ANTHROPIC_MODEL=
# AI provider: claude (default) or fake (deterministic replies for end-to-end tests, no API key needed)
AI_PROVIDER=
# Course name shown to the AI assistant (default 程式設計)
COURSE_NAME=

# Google OAuth (Auth.js)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed for `npm start` or self-hosting (not needed for `npm run dev` or Vercel)
AUTH_TRUST_HOST=

# PostgreSQL
DATABASE_URL=

# Comma-separated Google emails that get the teacher role (stage 0)
TEACHER_EMAILS=
